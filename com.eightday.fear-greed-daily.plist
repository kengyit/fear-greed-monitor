<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.eightday.fear-greed-daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <!-- Update this path to match your installation directory -->
        <string>/PATH/TO/fear-greed-monitor/fear_greed_monitor.sh</string>
        <string>--daily</string>
    </array>

    <!-- Fire daily at 9:35 PM (system local time — keep the Mac on SGT).
         If the Mac is asleep at 21:35, launchd runs the job on wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>21</integer>
        <key>Minute</key>
        <integer>35</integer>
    </dict>

    <!-- Also run once whenever the agent is (re)loaded — i.e. on every
         boot/login — so a 9:35 send missed while the machine was powered
         off is caught up. The script's once-per-day guard prevents
         duplicate sends. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Environment: ensure Homebrew binaries (jq) are in PATH -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>TZ</key>
        <string>Asia/Singapore</string>
    </dict>

    <!-- Logging -->
    <key>StandardOutPath</key>
    <string>/tmp/fear_greed_daily_launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/fear_greed_daily_launchd_err.log</string>

    <key>KeepAlive</key>
    <false/>

    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
