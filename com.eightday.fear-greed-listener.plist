<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.eightday.fear-greed-listener</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <!-- Update this path to match your installation directory -->
        <string>/PATH/TO/fear-greed-monitor/fear_greed_monitor.sh</string>
        <string>--listener</string>
    </array>

    <!-- Long-running daemon: start at boot/login and restart it
         automatically if it ever exits or crashes -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Environment: ensure Homebrew binaries (jq) are in PATH -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>TZ</key>
        <string>Asia/Singapore</string>
    </dict>

    <!-- Logging -->
    <key>StandardOutPath</key>
    <string>/tmp/fear_greed_listener_launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/fear_greed_listener_launchd_err.log</string>

    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
