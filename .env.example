# ============================================================
# Fear & Greed Monitor — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# Telegram Bot credentials (required)
# Get bot token from @BotFather on Telegram
# Get chat ID from @userinfobot on Telegram
FGI_TELEGRAM_BOT_TOKEN="your-telegram-bot-token-here"
FGI_TELEGRAM_CHAT_ID="your-telegram-chat-id-here"

# Alert threshold (optional, default: 10)
# Triggers when Fear & Greed Index drops below this value
FGI_THRESHOLD=10

# Monitoring window in SGT/UTC+8 (optional)
# Default: 9:00 PM to 4:30 AM (US market hours overlap)
FGI_WINDOW_START=21
FGI_WINDOW_END_HOUR=4
FGI_WINDOW_END_MIN=30

# Daily summary send time in SGT (optional, default: 9:35 PM)
# The daily summary is sent every day at this time regardless of the score
FGI_DAILY_HOUR=21
FGI_DAILY_MIN=35

# State file tracking the last daily-summary send date (optional)
# Kept in $HOME (not /tmp) so a reboot never causes a duplicate send
FGI_DAILY_STATE_FILE="$HOME/.fear_greed_daily_last_sent"

# Cooldown between alerts in minutes (optional, default: 120)
FGI_COOLDOWN_MINUTES=120

# Log file path (optional)
FGI_LOG_FILE="$HOME/logs/fear_greed.log"
